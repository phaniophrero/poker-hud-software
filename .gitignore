# Rust
/target/
**/target/
# Some tool configs (rust-analyzer's `checkOnSave`, in this case) point
# CARGO_TARGET_DIR at a second directory - seen here as
# `src-tauri/target-tooltip/` - so a background check doesn't lock-contend
# with a real `cargo build`. Same build-output story, never committed;
# caught only because staging everything once actually picked up its
# thousands of generated files.
/target-*/
**/target-*/

# Node / frontend
frontend/node_modules/
frontend/dist/
node_modules/
artifacts/

# Offline CNN training tool (frontend/scripts/train-rank-cnn) - its own
# nested node_modules/native bindings and the transient best-checkpoint
# saved during training, never the exported model itself
# (frontend/public/models/rank-cnn/, which the browser actually loads).
frontend/scripts/train-rank-cnn/node_modules/
frontend/scripts/train-rank-cnn/_best_checkpoint/
frontend/scripts/train-rank-cnn/_sweep_scratch/

# Local Hand History watcher (frontend/scripts/hh-watcher) - its persisted
# per-file read offsets are specific to this machine's real PokerStars
# files, never something to commit.
frontend/scripts/hh-watcher/.hh-watcher-state.json

# Local build output (packaged .app/.exe/.msi/.dmg) - large binaries,
# regenerated by `npm run tauri -- build` or CI, never committed.
/dist/

# Tauri generated
src-tauri/gen/schemas/

# OS
.DS_Store
Thumbs.db
.pokerstars-live*.png

# macOS AppleDouble resource-fork junk, picked up from a zip/tar transfer
# off a Mac - metadata placeholders, never real content, at any depth.
._*

# Packaged app binaries at the repo root - local build output (`npm run
# tauri -- build`), not source; distribute via GitHub Releases instead of
# committing them.
/PokerHUD.exe
/PokerHUD-Actualizat.exe

# Editors
.claude/
.vscode/*
!.vscode/extensions.json
.idea/

# Local app data written during dev runs (settings.json, calibration
# profiles, logs) - never something to commit.
.pokerhud-dev-data/

# Transient `npm run dev` logs left behind in frontend/ by past dev-server
# smoke tests (frontend/.<name>-vite.log, frontend/.<name>-vite-error.log).
frontend/.*-vite.log
frontend/.*-vite-error.log

# Calibration screenshots / templates are user-captured locally; only the
# folder structure and any explicitly-licensed sample assets are tracked
# (see datasets/README.md).
datasets/**/*.png
datasets/**/*.jpg
datasets/**/*.jpeg
!datasets/**/.gitkeep
